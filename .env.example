# Copy to .env and fill in real values. .env is git-ignored and loaded on startup
# (via python-dotenv in config/settings.py). Every variable is optional.

# --- LLM (OpenRouter) -------------------------------------------------------
# Without a key the app runs fully with rule-based fallbacks instead of the LLM.
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional; defaults to https://openrouter.ai/api/v1 when unset.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Replit AI Integrations equivalents (used only if the variables above are unset):
# AI_INTEGRATIONS_OPENROUTER_API_KEY=
# AI_INTEGRATIONS_OPENROUTER_BASE_URL=

# --- Metadata database (PostgreSQL) -----------------------------------------
# Optional. Used by the FastAPI service to record datasets/experiments.
DATABASE_URL=postgresql://user:password@localhost:5432/dsplatform

# --- App settings ------------------------------------------------------------
DEBUG=false
UPLOAD_DIR=data/uploads
